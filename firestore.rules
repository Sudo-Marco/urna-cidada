rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function uuidValido(id) {
      return id.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function votosCorretos(votos) {
      return votos is list && votos.size() == 5
        && votoCorreto(votos[0], 'Deputado Federal')
        && votoCorreto(votos[1], 'Deputado Estadual')
        && votoCorreto(votos[2], 'Senador')
        && votoCorreto(votos[3], 'Governador')
        && votoCorreto(votos[4], 'Presidente');
    }

    function votoCorreto(voto, cargo) {
      return voto is map
        && voto.keys().hasAll(['cargo', 'tipo', 'numero', 'dataHora'])
        && voto.keys().hasOnly(['cargo', 'tipo', 'numero', 'dataHora'])
        && voto.cargo == cargo
        && voto.tipo in ['VALIDO', 'LEGENDA', 'BRANCO', 'NULO']
        && voto.dataHora is string
        && voto.dataHora.size() <= 40
        && voto.dataHora.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$')
        && ((voto.tipo == 'BRANCO' && voto.numero == null)
          || (voto.tipo == 'LEGENDA' && numeroLegenda(cargo, voto.numero))
          || (voto.tipo == 'VALIDO' && numeroCandidato(cargo, voto.numero))
          || (voto.tipo == 'NULO' && tamanhoNumero(cargo, voto.numero)));
    }

    function numeroLegenda(cargo, numero) {
      return cargo == 'Deputado Federal' && numero in ['81', '82', '83', '11', '22', '33']
        || cargo == 'Deputado Estadual' && numero == '81';
    }

    function tamanhoNumero(cargo, numero) {
      return numero is string && numero.matches(cargo == 'Deputado Federal' ? '^[0-9]{4}$'
        : cargo == 'Deputado Estadual' ? '^[0-9]{5}$'
        : cargo == 'Senador' ? '^[0-9]{3}$' : '^[0-9]{2}$');
    }

    function numeroCandidato(cargo, numero) {
      return cargo == 'Deputado Federal' && numero in ['8101', '8202', '8303', '1111', '2222', '3333']
        || cargo == 'Deputado Estadual' && numero == '81001'
        || cargo == 'Senador' && numero in ['820', '830', '833']
        || cargo == 'Governador' && numero in ['84', '82', '83', '44', '55', '66']
        || cargo == 'Presidente' && numero in ['81', '85', '83', '11', '22', '33'];
    }

    function idResultado(cargo, numero) {
      return (cargo == 'Deputado Federal' ? 'df'
        : cargo == 'Deputado Estadual' ? 'de'
        : cargo == 'Senador' ? 'sen'
        : cargo == 'Governador' ? 'gov' : 'pres') + '_' + numero;
    }

    function indiceCargo(cargo) {
      return cargo == 'Deputado Federal' ? 0
        : cargo == 'Deputado Estadual' ? 1
        : cargo == 'Senador' ? 2
        : cargo == 'Governador' ? 3 : 4;
    }

    function votoDaSessao(sessaoId, cargo, numero) {
      let sessao = getAfter(/databases/$(database)/documents/sessoes/$(sessaoId)).data;
      let voto = sessao.votos[indiceCargo(cargo)];
      return voto.cargo == cargo && voto.tipo == 'VALIDO' && voto.numero == numero;
    }

    function marcadorDoParticipanteCriado() {
      let marcador = getAfter(/databases/$(database)/documents/participantes/$(request.auth.uid));
      return marcador.data.votou == true;
    }

    match /participantes/{uid} {
      allow get: if autenticado() && request.auth.uid == uid;
      allow list: if false;

      // O documento guarda somente o fato de que aquela conta já participou.
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['votou'])
        && request.resource.data.keys().hasOnly(['votou'])
        && request.resource.data.votou == true;
      allow update, delete: if false;
    }

    match /sessoes/{sessaoId} {
      allow create: if autenticado()
        && uuidValido(sessaoId)
        && !exists(/databases/$(database)/documents/participantes/$(request.auth.uid))
        && marcadorDoParticipanteCriado()
        && request.resource.data.keys().hasAll(['impressao', 'votos'])
        && request.resource.data.keys().hasOnly(['impressao', 'votos'])
        && request.resource.data.impressao is string
        && request.resource.data.impressao.matches('^[0-9a-f]{64}$')
        && votosCorretos(request.resource.data.votos)
        && (request.resource.data.votos[0].tipo != 'VALIDO' || getAfter(/databases/$(database)/documents/resultados/$(idResultado('Deputado Federal', request.resource.data.votos[0].numero))).data.ultimaSessaoId == sessaoId)
        && (request.resource.data.votos[1].tipo != 'VALIDO' || getAfter(/databases/$(database)/documents/resultados/$(idResultado('Deputado Estadual', request.resource.data.votos[1].numero))).data.ultimaSessaoId == sessaoId)
        && (request.resource.data.votos[2].tipo != 'VALIDO' || getAfter(/databases/$(database)/documents/resultados/$(idResultado('Senador', request.resource.data.votos[2].numero))).data.ultimaSessaoId == sessaoId)
        && (request.resource.data.votos[3].tipo != 'VALIDO' || getAfter(/databases/$(database)/documents/resultados/$(idResultado('Governador', request.resource.data.votos[3].numero))).data.ultimaSessaoId == sessaoId)
        && (request.resource.data.votos[4].tipo != 'VALIDO' || getAfter(/databases/$(database)/documents/resultados/$(idResultado('Presidente', request.resource.data.votos[4].numero))).data.ultimaSessaoId == sessaoId);

      // IDs UUID não seguem UID nem CPF e não podem ser listados.
      allow get: if autenticado() && uuidValido(sessaoId);
      allow list, update, delete: if false;
    }

    match /resultados/{resultadoId} {
      // A apuração fica disponível aos responsáveis pelo projeto no Console Firebase.
      allow read: if false;

      allow create: if autenticado()
        && request.resource.data.keys().hasAll(['cargo', 'numero', 'contagem', 'ultimaSessaoId'])
        && request.resource.data.keys().hasOnly(['cargo', 'numero', 'contagem', 'ultimaSessaoId'])
        && request.resource.data.contagem == 0
        && request.resource.data.ultimaSessaoId == null
        && numeroCandidato(request.resource.data.cargo, request.resource.data.numero)
        && resultadoId == idResultado(request.resource.data.cargo, request.resource.data.numero);

      allow update: if autenticado()
        && marcadorDoParticipanteCriado()
        && request.resource.data.keys().hasOnly(['cargo', 'numero', 'contagem', 'ultimaSessaoId'])
        && request.resource.data.cargo == resource.data.cargo
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.contagem == resource.data.contagem + 1
        && uuidValido(request.resource.data.ultimaSessaoId)
        && votoDaSessao(request.resource.data.ultimaSessaoId, resource.data.cargo, resource.data.numero);

      allow delete: if false;
    }
  }
}
