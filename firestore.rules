rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function votoValido(voto, cargoEsperado) {
      return voto is map
        && voto.keys().hasAll(['cargo', 'tipo', 'numero', 'dataHora'])
        && voto.keys().hasOnly(['cargo', 'tipo', 'numero', 'dataHora'])
        && voto.cargo is string
        && voto.cargo == cargoEsperado
        && voto.tipo is string
        && voto.tipo in ['VALIDO', 'LEGENDA', 'BRANCO', 'NULO']
        && voto.dataHora is string
        && voto.dataHora.size() <= 40
        && voto.dataHora.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$')
        && ((voto.tipo == 'BRANCO' && voto.numero == null)
          || (voto.tipo == 'LEGENDA'
            && cargoEsperado in ['Deputado Federal', 'Deputado Estadual']
            && voto.numero is string && voto.numero.matches('^[0-9]{2}$'))
          || (voto.tipo in ['VALIDO', 'NULO'] && voto.numero is string
            && voto.numero.matches(cargoEsperado == 'Deputado Federal' ? '^[0-9]{4}$'
              : cargoEsperado == 'Deputado Estadual' ? '^[0-9]{5}$'
              : cargoEsperado == 'Senador' ? '^[0-9]{3}$' : '^[0-9]{2}$')));
    }

    match /sessoes/{sessaoId} {
      allow create: if request.auth == null
        && sessaoId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && request.resource.data.keys().hasAll(['votos'])
        && request.resource.data.keys().hasOnly(['votos'])
        && request.resource.data.votos is list
        && request.resource.data.votos.size() == 5
        && votoValido(request.resource.data.votos[0], 'Deputado Federal')
        && votoValido(request.resource.data.votos[1], 'Deputado Estadual')
        && votoValido(request.resource.data.votos[2], 'Senador')
        && votoValido(request.resource.data.votos[3], 'Governador')
        && votoValido(request.resource.data.votos[4], 'Presidente');

      allow read, update, delete: if false;
    }
  }
}
